# =============================================================================
# Neon by Ascertn — Environment Variables
# =============================================================================

# Server Port (Default: 3001)
PORT=3001

# Google Gemini API Key (Optional)
# If provided, enables live generative AI for "Ask Neon", 1-Click SEO auto-optimization,
# and keyword cluster research. If left empty, Neon automatically uses high-fidelity
# deterministic intelligence so the UI and crawler work 100% offline out-of-the-box.
# You can also configure this directly inside the UI via the "Configure AI" modal.
GCP_API_KEY=your_gcp_api_key_here
VITE_GEMINI_API_KEY=

# Base URL / Domain
VITE_APP_URL=http://localhost:5173
