{
  "name": "neon-by-ascertn",
  "version": "1.0.0",
  "description": "Enterprise AI SEO, Website Builder & Omnichannel Visibility SaaS Platform",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": ".venv/bin/python -m uvicorn main:app --app-dir neon-backend --host 0.0.0.0 --port 8000 --reload",
    "server:node": "tsx server/index.ts",
    "start": "concurrently -k -p \"[{name}]\" -n \"FASTAPI,VITE\" -c \"green,cyan\" \"npm run server\" \"npm run dev\"",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "ai-seo",
    "website-builder",
    "growth",
    "omnichannel",
    "serp-auditor",
    "visibility-score"
  ],
  "dependencies": {
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "lucide-react": "^1.58.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.6",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
